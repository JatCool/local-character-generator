{
  "1": {"class_type": "UNETLoader", "_meta": {"title": "Krea 2 diffusion model"},
        "inputs": {"unet_name": "{{unet}}", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "_meta": {"title": "Qwen3-VL text encoder"},
        "inputs": {"clip_name": "{{text_encoder}}", "type": "krea2", "device": "default"}},
  "3": {"class_type": "VAELoader", "_meta": {"title": "VAE"},
        "inputs": {"vae_name": "{{vae}}"}},
  "10": {"class_type": "LoraLoaderModelOnly", "_meta": {"title": "Pixel Art LoRA"},
         "inputs": {"model": ["1", 0], "lora_name": "{{lora}}", "strength_model": "{{lora_strength}}"}},
  "6": {"class_type": "CLIPTextEncode", "_meta": {"title": "Positive"},
        "inputs": {"clip": ["2", 0], "text": "{{positive}}"}},
  "7": {"class_type": "ConditioningZeroOut", "_meta": {"title": "Empty negative (cfg 1)"},
        "inputs": {"conditioning": ["6", 0]}},
  "5": {"class_type": "EmptySD3LatentImage", "_meta": {"title": "Latent"},
        "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},
  "4": {"class_type": "KSampler", "_meta": {"title": "Sampler"},
        "inputs": {"model": ["10", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0],
                   "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}",
                   "sampler_name": "{{sampler}}", "scheduler": "{{scheduler}}", "denoise": 1.0}},
  "8": {"class_type": "VAEDecode", "_meta": {"title": "Decode"},
        "inputs": {"samples": ["4", 0], "vae": ["3", 0]}},
  "9": {"class_type": "SaveImage", "_meta": {"title": "Save"},
        "inputs": {"images": ["8", 0], "filename_prefix": "{{prefix}}"}}
}
