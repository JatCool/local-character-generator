{
  "4": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "Checkpoint (same as the character)"},
        "inputs": {"ckpt_name": "{{checkpoint}}"}},
  "10": {"class_type": "LoraLoader", "_meta": {"title": "Pixel Art LoRA"},
         "inputs": {"model": ["4", 0], "clip": ["4", 1], "lora_name": "{{lora}}",
                    "strength_model": "{{lora_strength}}", "strength_clip": "{{lora_clip_strength}}"}},
  "6": {"class_type": "CLIPTextEncode", "_meta": {"title": "Positive (character prompt + hidden-torso hint)"},
        "inputs": {"clip": ["10", 1], "text": "{{positive}}"}},
  "7": {"class_type": "CLIPTextEncode", "_meta": {"title": "Negative (+ arm, hand, weapon)"},
        "inputs": {"clip": ["10", 1], "text": "{{negative}}"}},
  "20": {"class_type": "LoadImage", "_meta": {"title": "Character source (1024 px)"},
         "inputs": {"image": "{{image}}"}},
  "21": {"class_type": "LoadImageMask", "_meta": {"title": "Mask: near arm + weapon over the torso (white = repaint)"},
         "inputs": {"image": "{{mask}}", "channel": "red"}},
  "5": {"class_type": "VAEEncodeTiled", "_meta": {"title": "Encode source"},
        "inputs": {"pixels": ["20", 0], "vae": ["4", 2], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8}},
  "22": {"class_type": "SetLatentNoiseMask", "_meta": {"title": "Only the masked area is re-sampled"},
         "inputs": {"samples": ["5", 0], "mask": ["21", 0]}},
  "3": {"class_type": "KSampler", "_meta": {"title": "Sampler (character seed)"},
        "inputs": {"model": ["10", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["22", 0],
                   "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}",
                   "sampler_name": "{{sampler}}", "scheduler": "{{scheduler}}", "denoise": "{{denoise}}"}},
  "8": {"class_type": "VAEDecodeTiled", "_meta": {"title": "Decode"},
        "inputs": {"samples": ["3", 0], "vae": ["4", 2], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8}},
  "23": {"class_type": "ImageCompositeMasked", "_meta": {"title": "Keep every pixel outside the mask"},
         "inputs": {"destination": ["20", 0], "source": ["8", 0], "x": 0, "y": 0, "resize_source": false, "mask": ["21", 0]}},
  "9": {"class_type": "SaveImage", "_meta": {"title": "Save"},
        "inputs": {"images": ["23", 0], "filename_prefix": "{{prefix}}"}}
}
