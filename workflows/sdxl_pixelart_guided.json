    "3",
    0
   ],
   "vae": [
    "4",
    2
   ],
   "tile_size": 512,
   "overlap": 64,
   "temporal_size": 64,
   "temporal_overlap": 8
  }
 },
 "9": {
  "class_type": "SaveImage",
  "_meta": {
   "title": "Save"
  },
  "inputs": {
