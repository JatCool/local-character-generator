    "21",
    0
   ],
   "vae": [
    "4",
    2
   ],
   "tile_size": 512,
   "overlap": 64,
   "temporal_size": 64,
   "temporal_overlap": 8
  }
 },
 "3": {
  "class_type": "KSampler",
  "_meta": {
   "title": "Sampler"
  },
  "inputs": {
   "model": [
    "10",
    0
   ],
   "positive": [
    "6",
    0
   ],
   "negative": [
    "7",
    0
   ],
   "latent_image": [
    "5",
    0
   ],
   "seed": "{{seed}}",
   "steps": "{{steps}}",
   "cfg": "{{cfg}}",
   "sampler_name": "{{sampler}}",
   "scheduler": "{{scheduler}}",
   "denoise": "{{denoise}}"
  }
 },
 "8": {
  "class_type": "VAEDecodeTiled",
  "_meta": {
   "title": "Decode (tiled: avoids the 10 GB VRAM stall)"
